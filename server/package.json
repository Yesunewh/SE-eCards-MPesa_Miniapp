{
  "name": "ecards-server",
  "version": "0.1.0",
  "private": true,
  "description": "eCards M-Pesa mini app backend: catalog, orders, M-Pesa payments, gift card fulfilment (stock + Wupex), support.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "provider:map": "node dist/scripts/provider-map.js",
    "provider:map:dev": "tsx src/scripts/provider-map.ts",
    "mpesa:register-urls": "node dist/scripts/mpesa-register-urls.js",
    "data:clear-test": "node dist/scripts/clear-test-data.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
