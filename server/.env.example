# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://ecards:ecards@localhost:5432/ecards
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=https://ecard-miniapp.paperless.et,http://localhost:8000

# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing CODE_ENCRYPTION_KEY means losing every gift card code in stock. Back it up separately from the database.
CODE_ENCRYPTION_KEY=
CODE_HMAC_KEY=

# Run the background worker in this process (fulfilment, payment checks, expiry)
RUN_WORKER=true

# ---- M-Pesa (Safaricom Ethiopia) ----
# mpesa_et = M-Pesa Ethiopia H5 mini app · mock = test payments (no money moves; staff record M-Pesa receipts in the admin panel)
# · safaricom = STK push
PAYMENTS_ADAPTER=mock
MPESA_BASE_URL=https://apisandbox.safaricom.et
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public URL M-Pesa calls back; the secret below is appended to the path
PUBLIC_BASE_URL=https://api.example.et
MPESA_CALLBACK_SECRET=

# ---- M-Pesa Ethiopia H5 mini app (PAYMENTS_ADAPTER=mpesa_et) — what eCards uses ----
# Login: my.call('userScopes') in the app. Pay: my.call('payWithMpesa') + C2B Validation/Confirmation callbacks.
# MPESA_SHORTCODE = business number (businessID); MPESA_CONSUMER_KEY/SECRET from developer.safaricom.et → My Apps.
# MPESA_BASE_URL: https://apisandbox.safaricom.et (sandbox) or the live URL. Then: npm run mpesa:register-urls

# ---- (not used for M-Pesa Ethiopia) generic mini program template (PAYMENTS_ADAPTER=miniapp) ----
# Values from M-Pesa Ethiopia mini program onboarding. Keys: PEM text, base64 of it, or a file path.
MINIAPP_GATEWAY_URL=
MINIAPP_API_PREFIX=/api
MINIAPP_CLIENT_ID=
MINIAPP_APP_ID=
MINIAPP_AUTH_CLIENT_ID=
MINIAPP_PRIVATE_KEY=/opt/ecards/keys/mpesa-private.pem
MINIAPP_PLATFORM_PUBLIC_KEY=/opt/ecards/keys/mpesa-platform-public.pem
MINIAPP_KEY_VERSION=1
MINIAPP_CURRENCY=ETB
# amount sent as santim ("1325000", minor) or Birr ("13250", major): confirm with M-Pesa
MINIAPP_AMOUNT_UNIT=minor
MINIAPP_PRODUCT_CODE=CASHIER_PAYMENT
# profile endpoint for name / phone (leave empty for the default /api/v1/customers/user/inquiryUserInfo)
MINIAPP_USERINFO_PATH=

# ---- Gift card provider ----
# wupex = buy codes from Wupex · none = only codes uploaded in the admin panel · mock = generated codes (tests only)
GIFTCARD_ADAPTER=mock
# API (service) URL. sandbox: https://sandbox-service.wupex.com · production: the service URL Wupex gives you.
# Not the portal address: the portal refuses API calls.
WUPEX_BASE_URL=
# portal → API keys (keep it secret: it spends the Wupex balance)
WUPEX_API_KEY=
# portal → avatar (top right) → merchant code
WUPEX_MERCHANT=
# currency of Wupex prices and balance
WUPEX_CURRENCY=USD

# ---- Delivering codes ----
NOTIFY_ADAPTER=log
